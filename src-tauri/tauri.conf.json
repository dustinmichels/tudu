{
	"$schema": "https://schema.tauri.app/config/2",
	"productName": "TuDu",
	"version": "0.1.0",
	"identifier": "com.tudu.app",
	"build": {
		"beforeDevCommand": "bun run dev",
		"devUrl": "http://localhost:1420",
		"beforeBuildCommand": "bun run build",
		"frontendDist": "../dist"
	},
	"app": {
		"windows": [
			{
				"title": "TuDu",
				"width": 1280,
				"height": 800,
				"minWidth": 800,
				"minHeight": 600,
				"maximized": true,
				"dragDropEnabled": false
			}
		],
		"security": {
			"csp": "default-src 'self'; img-src 'self' asset: https: data:; style-src 'self' 'unsafe-inline'"
		}
	},
	"bundle": {
		"active": true,
		"targets": "all",
		"icon": [
			"icons/32x32.png",
			"icons/128x128.png",
			"icons/128x128@2x.png",
			"icons/icon.icns",
			"icons/icon.ico"
		]
	}
}
